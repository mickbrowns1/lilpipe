{
  "name": "Dedupe repeated lines",
  "source": {
    "type": "generator",
    "format": "shuffle",
    "count": 2000,
    "lines": "login failed for admin\nlogin failed for admin\nlogin failed for admin\nhealth check ok\nhealth check ok\nhealth check ok\nhealth check ok\ndisk usage at 91%\nbackup completed"
  },
  "transforms": [
    {
      "type": "remap",
      "source": "if contains(string!(.message), \"failed\") {\n  .severity = \"high\"\n} else {\n  .severity = \"low\"\n}"
    },
    {
      "type": "dedupe",
      "fields": "message"
    }
  ],
  "sink": {
    "type": "devnull",
    "filename": "pipeline-output.ndjson"
  }
}
